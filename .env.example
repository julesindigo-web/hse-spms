# Firebase Web Config (isi dari Firebase Console → Project Settings)
# Kosongkan = aplikasi jalan dalam MODE DEMO lokal (IndexedDB + seed data), tetap bisa di-deploy Vercel.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
# Apps Script Web App URL (bridge Drive, §19/§23)
VITE_APPS_SCRIPT_URL=
# Recaptcha v3 site key untuk App Check (opsional, §22)
VITE_RECAPTCHA_SITE_KEY=
